PORT=4000
NODE_ENV=production
CLIENT_ORIGINS=https://your-client-domain.com
FRONTEND_URL=https://your-client-domain.com
PUBLIC_BASE_URL=https://your-api-domain.com
JWT_SECRET=replace_with_long_random_string
DB_PATH=./data/farmbarn.db
AUTO_SEED=false

# Admin login
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace_with_strong_password

# Sales contact
SALES_EMAIL=sales@example.com

# SMTP (for order notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=replace_with_smtp_password

# Stripe secret key (backend)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_...
